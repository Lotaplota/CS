digraph abc { // Grafo direcionado
    rankdir = LR;
    node[shape = circle, fontsize = 18];

    qi [shape = point];
    q0 [label = "q0"];
    q1 [label = "q1"];
    q2 [label = "q2"];
    q3 [label = "q3", shape = doublecircle];

    qi -> q0;
    q0 -> q1 [label = "a"];
    q1 -> q2 [label = "b"];
    q2 -> q3 [label = "c"];
    q1 -> q1 [label = "c"];


}