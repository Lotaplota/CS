// Autômato para CPF
digraph abc {
    rankdir = TB;
    node[shape = circle, fontsize = 18];

    p [shape = point];
    q0 [label = "q0"];
    q1 [label = "q1"]
    q2 [label = "q2"]
    q3 [label = "q3"]
    q4 [label = "q4"]
    q5 [label = "q5"]
    q6 [label = "q6"]
    q7 [label = "q7", shape = doublecircle];

    p -> q0;
    q0 -> q1 [label = "[0-9]{3}"];
    q1 -> q2 [label = ".", fontsize = 25];
    q2 -> q3 [label = "[0-9]{3}"];
    q3 -> q4 [label = ".", fontsize = 25];
    q4 -> q5 [label = "[0-9]{3}"];
    q5 -> q6 [label = "-", fontsize = 25];
    q6 -> q7 [label = "[0-9]{2}"];
}