// Automato para a*c
digraph abc {
    rankdir = LR;
    node[shape = circle];

    p [shape = point];
    q0 [label = "q0"];
    q1 [label = "q1"];
    q2 [label = "q2", shape = doublecircle];
    Erro

    p -> q0;
    q0 -> q1 [label = "a"];
    q1 -> q1 [label = "[a-z]-c"];
    q1 -> q2 [label = "c"];
    q2 -> q2 [label = "c"];
    q2 -> q1 [label = "[a-z]-c"];
    q0 -> Erro [label = "[a-z]-a"]
}